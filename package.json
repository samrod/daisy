{
  "name": "daisy",
  "private": true,
  "enableInlineHunks": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"yarn workspace daisy-web start\" \"yarn workspace daisy-payment dev\""
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
