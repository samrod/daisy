{
  "name": "daisy-api",
  "packageManager": "yarn@4.5.0",
  "scripts": {
    "dev": "NODE_ENV=development PORT=5001 ts-node-dev --inspect-brk --respawn --transpile-only src/server.ts",
    "start": "NODE_ENV=PRODUCTION node dist/server.js",
    "build": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.1",
    "stripe": "^14.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/stripe": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
